{#
  Icons of the theme switch (overridable/partials/theme-toggle.njk). Each shows what a click
  switches to: __icon--to-dark while light (aria-pressed="false"), __icon--to-light while dark.
  theme.css hides the other one by these classes. Decorative: aria-hidden, the button has the name.
#}
<svg class="theme-toggle__icon theme-toggle__icon--to-dark" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
<svg class="theme-toggle__icon theme-toggle__icon--to-light" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
