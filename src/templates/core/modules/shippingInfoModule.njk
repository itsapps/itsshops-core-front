{#- "Versand & Zahlung": the editor-written payment text (module.paymentInfo, plain text — Stripe
    decides the methods, not Sanity; section omitted when empty), then the shipping methods from the
    same documents the checkout prices with (countries = delivery restrictions, rates as rules —
    never invented totals; gross prices as charged), then the harmonised warranty notice.
    Outline: h2 Zahlung · h2 Versand > h3 per method · h2 Gewährleistung. FAGG §8 (3). -#}
{%- set _methods = cms[_locale].shippingMethods or [] -%}
<div class="shipping-info">
  {%- if module.paymentInfo %}
  <section class="shipping-info__payment">
    <h2>{{ 'shippingInfo.paymentHeading' | trans }}</h2>
    {{ module.paymentInfo | paragraphs | safe }}
  </section>
  {%- endif %}

  <section class="shipping-info__shipping">
    <h2>{{ 'shippingInfo.shippingHeading' | trans }}</h2>
    {%- for method in _methods %}
    <section class="shipping-info__method">
      <h3>{{ method.title }}</h3>
      <dl class="shipping-info__facts">
        <dt>{{ 'shippingInfo.type' | trans }}</dt>
        <dd>{{ ('shippingInfo.types.' + method.methodType) | trans }}</dd>
        {%- if method.deliveryTime %}
        <dt>{{ 'shippingInfo.deliveryTime' | trans }}</dt>
        <dd>{{ method.deliveryTime }}</dd>
        {%- endif %}
        {%- if method.countries.length %}
        <dt>{{ 'shippingInfo.countries' | trans }}</dt>
        <dd>{% for code in method.countries %}{{ code | countryName }}{% if not loop.last %}, {% endif %}{% endfor %}</dd>
        {%- endif %}
        {%- if method.methodType == 'pickup' %}
        <dt>{{ 'shippingInfo.pickupFee' | trans }}</dt>
        <dd>{% if method.pickupFee %}{{ method.pickupFee | formatPrice }}{% else %}{{ 'shippingInfo.free' | trans }}{% endif %}</dd>
        {%- endif %}
        {%- if method.freeShippingThreshold %}
        <dt>{{ 'shippingInfo.freeShipping' | trans }}</dt>
        <dd>{{ 'shippingInfo.freeShippingFrom' | trans({ amount: method.freeShippingThreshold | formatPrice }) }}</dd>
        {%- endif %}
      </dl>

      {%- for config in method.packagingConfigs %}
      {%- if config.packages.length %}
      <table class="shipping-info__table">
        <caption>{{ 'shippingInfo.packagingCaption' | trans({ volume: config.volume | formatVolume }) }}</caption>
        <thead><tr>
          <th scope="col">{{ 'shippingInfo.package' | trans }}</th>
          <th scope="col">{{ 'shippingInfo.price' | trans }}</th>
        </tr></thead>
        <tbody>
          {%- for package in config.packages %}
          <tr>
            <td>{{ 'shippingInfo.packageCount' | trans({ count: package.count }) }}</td>
            <td>{{ package.price | formatPrice }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
      {%- endif %}
      {%- endfor %}

      {%- if method.rates.length %}
      <table class="shipping-info__table">
        <caption>{{ ('shippingInfo.ratesCaption' + ('Other' if method.packagingConfigs.length else '')) | trans }}</caption>
        <thead><tr>
          <th scope="col">{{ 'shippingInfo.weight' | trans }}</th>
          <th scope="col">{{ 'shippingInfo.price' | trans }}</th>
        </tr></thead>
        <tbody>
          {%- for rate in method.rates %}
          <tr>
            <td>{% if rate.maxWeight %}{{ 'shippingInfo.upTo' | trans({ weight: rate.maxWeight | formatNumber }) }}{% else %}{{ 'shippingInfo.anyWeight' | trans }}{% endif %}</td>
            <td>{{ rate.price | formatPrice }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
      {%- endif %}
    </section>
    {%- endfor %}
    <p class="shipping-info__note">{{ 'shippingInfo.pricesGross' | trans }}</p>
  </section>

  <section class="shipping-info__guarantee" id="{{ 'legalGuarantee.anchor' | trans }}">
    <h2>{{ 'shippingInfo.legalGuarantee' | trans }}</h2>
    {% include "core/components/partials/legal-guarantee-notice.njk" %}
  </section>
</div>
